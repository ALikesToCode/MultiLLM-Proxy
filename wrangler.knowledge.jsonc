{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "multillm-knowledge",
  "main": "worker/knowledge/index.mjs",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["enable_request_signal", "request_signal_passthrough"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "INTELLIGENCE_DB",
    "database_name": "multillm-intelligence",
    "database_id": "0e64ec48-b454-4876-a4aa-3fb2c240fd3d",
    "migrations_dir": "intelligence-migrations"
  }],
  "durable_objects": {
    "bindings": [{ "name": "KNOWLEDGE_AUTHORITY", "class_name": "KnowledgeCatalogue" },
      { "name": "KNOWLEDGE_MEMOS", "class_name": "KnowledgeMemos" },
      { "name": "KNOWLEDGE_HANDOFFS", "class_name": "KnowledgeHandoffs" }]
  },
  "migrations": [{ "tag": "knowledge-v1", "new_sqlite_classes": ["KnowledgeCatalogue"] },
    { "tag": "knowledge-memos-v1", "new_sqlite_classes": ["KnowledgeMemos"] },
    { "tag": "add-knowledge-handoffs", "new_sqlite_classes": ["KnowledgeHandoffs"] }],
  "r2_buckets": [{ "binding": "KNOWLEDGE_SNAPSHOTS", "bucket_name": "multillm-knowledge-snapshots" }],
  "ai_search": [{ "binding": "KNOWLEDGE_INDEX", "instance_name": "multillm-knowledge" }],
  "ai": { "binding": "KNOWLEDGE_SEARCH_AI" },
  "vars": { "KNOWLEDGE_SEARCH_INSTANCE": "multillm-knowledge" },
  "workflows": [{ "binding": "KNOWLEDGE_INGESTION", "name": "multillm-knowledge-ingestion", "class_name": "KnowledgeIngestion" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
